schema_version = 2
generator = "openspider 0.1.0"
mode = "spider"
cdns = []

[scope]
all_subdomains = false
subfolder_only = false
crawl_outside_start_folder = true
regex_partial_match = false
include = []
exclude = []

[spider]
css_style_attributes = false
follow_internal_nofollow = false
follow_external_nofollow = false
store_uncrawlable_links = false

[spider.images]
store = true
crawl = true

[spider.css]
store = true
crawl = true

[spider.javascript]
store = true
crawl = true

[spider.media]
store = true
crawl = true

[spider.internal]
store = true
crawl = true

[spider.external]
store = true
crawl = true

[spider.canonicals]
store = true
crawl = true

[spider.hreflang]
store = true
crawl = false

[spider.pagination]
store = true
crawl = false

[spider.meta_refresh]
store = true
crawl = true

[spider.iframes]
store = true
crawl = true

[spider.amp]
store = false
crawl = false

[spider.mobile_alternate]
store = true
crawl = false

[limits]
max_urls = 5000000
max_redirects = 10
max_page_kb = 51200
max_url_length = 10000
max_links_per_url = 10000

[speed]
threads = 5
adaptive_throttle = true
auto = false
connections_per_host = "auto"

[user_agent]
preset = "openspider"

[robots]
mode = "respect"
unreachable_policy = "block_host"
retries = 2
retry_delay_s = 5
show_blocked_internal = true
show_blocked_external = false
respect_crawl_delay = false

[robots.custom_files]

[advanced]
cookies = "session_only"
response_timeout_s = 20
assume_html = false
respect_self_ref_meta_refresh = false
crawl_fragments = false
respect_noindex = false
respect_canonical = false
html_validation = true
green_hosting = false
always_follow_redirects = false
always_follow_canonicals = false

[auth]
basic = []
form = []
session_guard = []
profile_refs = []

[network]
resolve = []

[rendering]
mode = "text"
ajax_timeout_s = 5.0
js_error_reporting = true
restart_after_pages = 500
restart_memory_mb = 1500
page_timeout_s = 60

[rendering.viewport]
preset = "googlebot_mobile"
width = 411
height = 731
scale_factor = 1.0
mobile = true
touch = true

[rendering.screenshots]
enabled = true
fit_to_content = false
wait_ms = 300
format = "png"
jpeg_quality = 80

[extraction]
page_titles = true
meta_description = true
meta_keywords = true
h1 = true
h2 = true
hash = true
response_time = true
last_modified = true
http_headers = false
store_html = false
store_rendered_html = false
indexability = true
word_count = true
readability = true
text_ratio = true
page_size = true
forms = true
accessibility = false
cookies = false
meta_robots = true
x_robots_tag = true
srcset = false

[extraction.structured_data]
json_ld = false
microdata = false
rdfa = false
schema_org_validation = true
rich_results_validation = true
case_sensitive = false

[content]
low_word_count = 200
soft404_phrases = [
    "page not found",
    "404 not found",
    "error 404",
    "404 error",
    "page cannot be found",
    "page can't be found",
    "page could not be found",
    "seite nicht gefunden",
    "seite wurde nicht gefunden",
    "fehler 404",
    "404 fehler",
    "page introuvable",
    "página no encontrada",
    "pagina non trovata",
    "pagina niet gevonden",
]

[content.area]
include_elements = []
include_classes = []
include_ids = []
exclude_elements = [
    "nav",
    "footer",
    "header",
    "aside",
]
exclude_classes = []
exclude_ids = []

[content.readability]
language_aware = false

[title]
max_chars = 60
min_chars = 30
max_px = 561
min_px = 200

[meta_description]
max_chars = 155
min_chars = 70
max_px = 985
min_px = 400

[url]
max_chars = 115
internal_search_segments = [
    "search",
    "suche",
    "recherche",
    "buscar",
    "busca",
    "cerca",
    "zoeken",
    "szukaj",
    "sok",
    "haku",
    "catalogsearch",
]
internal_search_params = [
    "q",
    "query",
    "search",
    "search_query",
    "searchterm",
    "keyword",
    "keywords",
    "k",
    "term",
]

[h1]
max_chars = 70

[h2]
max_chars = 70

[image]
max_kb = 100
alt_max_chars = 100

[duplicates]
only_indexable = true
ignore_paginated = true
exact_enabled = true
near_enabled = false
near_threshold_pct = 90

[issues]
ignore_non_indexable = true

[pdf]
store = false
extract_properties = false
extract_link_text = false

[links]
high_crawl_depth = 4
high_internal_outlinks = 1000
high_external_outlinks = 100
non_descriptive_anchors = [
    "click here",
    "click",
    "here",
    "this",
    "this page",
    "link",
    "more",
    "read more",
    "learn more",
    "more info",
    "more information",
    "find out more",
    "details",
    "continue",
    "go",
    "start",
    "hier",
    "hier klicken",
    "klicken sie hier",
    "mehr",
    "weiter",
    "weiterlesen",
    "mehr erfahren",
    "mehr lesen",
    "mehr info",
    "details ansehen",
]

[hreflang]
over_limit = "truncate"
allow_script_subtag = true

[sitemaps]
crawl_linked = false
auto_discover_robots = true
urls = []

[analysis]
auto_at_end = true
link_score = true
canonicals = true
pagination = true
hreflang = true
links = true
sitemaps = true
content = true
images = true
analytics = true
search_console = true
link_metrics = true
amp = true
near_duplicates = true

[validation]
html_doc_max_bytes = 2097152
resource_max_bytes = 2097152

[export]
show_credentials = false
utf8_bom = true
line_ending = "crlf"
inlinks_for_all_filters = true

[spelling]
enabled = false
mode = "auto"
manual_language = "en-US"
default_language = "en"

[spelling.default_variants]
de = "de-DE"
en = "en-US"
es = "es-ES"
fr = "fr-FR"
it = "it-IT"

[grammar]
enabled = false
disabled_rules = []

[custom_search]
filters = []
regex_timeout_ms = 2000

[custom_extraction]
extractors = []

[custom_js]
snippets = []

[[link_positions.rules]]
position = "Navigation"
contains = [
    "nav",
    "menu",
]

[[link_positions.rules]]
position = "Header"
contains = ["header"]

[[link_positions.rules]]
position = "Aside"
contains = ["aside"]

[[link_positions.rules]]
position = "Sidebar"
contains = ["sidebar"]

[[link_positions.rules]]
position = "Footer"
contains = ["footer"]

[[link_positions.rules]]
position = "Content"
contains = []

[rewrite]
remove_parameters = []
remove_all_parameters = false
regex_replace = []

[http]
headers = []
version = "auto"
retries_5xx = 0
retries_network = 1
throttle_on_429 = true
respect_hsts = true
ignore_certificate_errors = false

[api.ga4]
crawl_new_urls = false
enabled = false
metrics = []

[api.ga4.date_range]
preset = "last_30_days"

[api.ga4.limits]
retries = 5
concurrency = 5
window_s = 60

[api.ga4.url_match]
ignore_trailing_slash = true
ignore_case = true

[api.gsc]
crawl_new_urls = false
enabled = false
search_type = "web"
url_inspection = false

[api.gsc.date_range]
preset = "last_30_days"

[api.gsc.limits]
retries = 5
concurrency = 5
window_s = 60

[api.gsc.url_match]
ignore_trailing_slash = true
ignore_case = true

[api.psi]
enabled = false
device = "mobile"
local = false
metric_groups = []

[api.psi.limits]
retries = 5
concurrency = 5
window_s = 60

[api.majestic]
enabled = false
levels = []
metrics = []

[api.majestic.options]
historic = false
include_external = false
average_volume = false
moz_paid = false
moz_free_interval_s = 10

[api.majestic.limits]
retries = 5
concurrency = 5
window_s = 60

[api.ahrefs]
enabled = false
levels = []
metrics = []

[api.ahrefs.options]
historic = false
include_external = false
average_volume = false
moz_paid = false
moz_free_interval_s = 10

[api.ahrefs.limits]
retries = 5
concurrency = 5
window_s = 60

[api.moz]
enabled = false
levels = []
metrics = []

[api.moz.options]
historic = false
include_external = false
average_volume = false
moz_paid = false
moz_free_interval_s = 10

[api.moz.limits]
retries = 5
concurrency = 5
window_s = 60

[api.drive]
enabled = false

[api.drive.limits]
retries = 5
concurrency = 5
window_s = 60

[segments]
list = []

[compare]
mapping = []

[compare.change_detection]
elements = [
    "indexability",
    "page_titles",
    "meta_description",
    "h1",
    "word_count",
    "crawl_depth",
    "inlinks",
    "unique_inlinks",
    "internal_outlinks",
    "unique_internal_outlinks",
    "external_outlinks",
    "unique_external_outlinks",
    "structured_data_unique_types",
    "canonical",
    "redirect_target",
]
content_threshold_pct = 10

[sitemap_gen]
include_noindex = false
include_canonicalised = false
include_paginated = false
include_pdfs = false
include_3xx = false
include_4xx = false
include_5xx = false
include_no_response = false
exclude_patterns = []

[sitemap_gen.lastmod]
enabled = true
source = "server"

[sitemap_gen.priority]
enabled = true
by_depth = [
    1.0,
    0.9,
    0.8,
    0.7,
    0.6,
    0.5,
]

[sitemap_gen.changefreq]
enabled = true
basis = "last_modified"
by_depth = [
    "daily",
    "daily",
    "weekly",
    "weekly",
    "monthly",
]

[sitemap_gen.images]
enabled = false
external_regex = []
exclude_noindex = false

[sitemap_gen.hreflang]
enabled = false
only_valid_targets = true

[serp.desktop]
title_font_px = 20.0
description_font_px = 14.0

[serp.mobile]
title_max_px = 561
description_max_px = 680
title_font_px = 20.0
description_font_px = 14.0

[serp.tablet]
title_max_px = 561
description_max_px = 680
title_font_px = 20.0
description_font_px = 14.0

[ui]
parity_filters = true

[ui.columns]

[images]
real_dimensions_from_header = false
parse_inline_css_backgrounds = false
incorrect_size_min_saving_kb = 4

[security]
obsolete_mime_types = [
    "text/javascript",
    "application/x-javascript",
]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Aufbau eines Requests an POST /v1/decisions laut docs/spec/08-ai.md AI-004 (Beschreibung); Bilder nur als Base64-Data-URL, keine HTTP-URL, keine file_id; höchstens 10 Fragen je Request (OS-Festlegung bis GA). Unabhängige Abnahme M4-K02.",
  "type": "object",
  "required": ["model", "input", "questions"],
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "input": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"const": "user"},
              "content": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/part"}
              }
            }
          }
        }
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "part": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {"type": {"const": "input_text"}, "text": {"type": "string"}}
        },
        {
          "type": "object",
          "required": ["type", "image_url"],
          "not": {"required": ["file_id"]},
          "properties": {
            "type": {"const": "input_image"},
            "image_url": {"type": "string", "pattern": "^data:image/[a-z0-9.+-]+;base64,[A-Za-z0-9+/]+=*$"}
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["name", "type", "instructions"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["predicate", "choice", "score"]},
        "instructions": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "choice"}}},
          "then": {
            "required": ["choices"],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "description"],
                  "properties": {"value": {"type": "string"}, "description": {"type": "string"}}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "score"}}},
          "then": {
            "required": ["levels"],
            "properties": {
              "levels": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["label", "description"],
                  "properties": {"label": {"type": "string"}, "description": {"type": "string"}}
                }
              }
            }
          }
        }
      ]
    }
  }
}

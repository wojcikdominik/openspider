        "minimum": 0
      },
      "output_per_million": {
        "type": "number",
        "minimum": 0
      },
      "cache_read_per_million": {
        "type": "number",
        "minimum": 0
      },
      "cache_write_per_million": {
        "type": "number",
        "minimum": 0
      },
      "batch_discount": {
        "type": "number",
        "minimum": 0
      },
      "regional_uplift_percent": {
        "type": "number",
        "minimum": 0
      },
      "per_request": {
        "type": "number",
        "minimum": 0
      },
      "per_image": {
        "type": "number",
        "minimum": 0
      },
      "image_tokens": {
        "type": "number",
        "minimum": 0
      },
      "provider": {
        "type": "string",

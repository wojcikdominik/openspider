{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "resources/ai/provider-limits.json (AI-012, Nachtrag Q00): Grundanteil je Decisions-Frage und Schema-Zuschlag je Anbieter, jeweils mit Quelle und Prüfdatum.",
  "type": "object",
  "properties": {
    "note": { "type": "string" },
    "decisions_question_overhead_tokens": {
      "type": "object",
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "source_url": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/date" }
      },
      "required": ["value", "source_url", "verified_at"],
      "additionalProperties": false
    },
    "schema_overhead_tokens": {
      "type": "object",
      "properties": {
        "default_tokens": { "type": "integer", "minimum": 0 },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "endpoint": { "enum": ["messages", "responses", "decisions", "chat-completions", "embeddings"] },
              "model_prefix": { "type": "string", "minLength": 1 },
              "tokens": { "type": "integer", "minimum": 0 }
            },
            "required": ["provider", "tokens"],
            "additionalProperties": false
          }
        },
        "source_url": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/date" }
      },
      "required": ["default_tokens", "rules", "source_url", "verified_at"],
      "additionalProperties": false
    }
  },
  "required": ["decisions_question_overhead_tokens", "schema_overhead_tokens"],
  "additionalProperties": false,
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}

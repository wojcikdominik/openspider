{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Standardwerte je Aufgabentyp resources/ai/task-defaults.json (AI-011, Nachtrag Q00). Standardmodelle bestätigt der Nutzer (E-4 b, K4-20); bis dahin models_status pending-confirmation und model null.",
  "type": "object",
  "properties": {
    "models_status": { "enum": ["pending-confirmation", "confirmed"] },
    "source_url": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "test_only": { "type": "boolean" },
    "note": { "type": "string" },
    "tasks": {
      "type": "object",
      "properties": {
        "decision": { "$ref": "#/$defs/decisionTask" },
        "decision-vision": { "$ref": "#/$defs/decisionTask" },
        "redirect-confirm": { "$ref": "#/$defs/decisionTask" },
        "suggest-title": { "$ref": "#/$defs/textTask" },
        "suggest-meta": { "$ref": "#/$defs/textTask" },
        "suggest-h1": { "$ref": "#/$defs/textTask" },
        "suggest-alt": { "$ref": "#/$defs/textTask" },
        "link-anchor": { "$ref": "#/$defs/textTask" },
        "ask-sql": { "$ref": "#/$defs/textTask" },
        "audit-summary": { "$ref": "#/$defs/textTask" },
        "llms-summary": { "$ref": "#/$defs/textTask" },
        "embedding": { "$ref": "#/$defs/embeddingTask" }
      },
      "required": [
        "decision",
        "decision-vision",
        "redirect-confirm",
        "suggest-title",
        "suggest-meta",
        "suggest-h1",
        "suggest-alt",
        "link-anchor",
        "ask-sql",
        "audit-summary",
        "llms-summary",
        "embedding"
      ],
      "additionalProperties": false
    }
  },
  "required": ["models_status", "source_url", "verified_at", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "reasoning": { "enum": ["model-default", "off", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "modelRef": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint": { "enum": ["messages", "responses", "decisions", "chat-completions", "embeddings"] }
      },
      "required": ["provider", "model", "endpoint"],
      "additionalProperties": false
    },
    "model": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/modelRef" }] },
    "fallback": { "type": "array", "items": { "$ref": "#/$defs/modelRef" } },
    "decisionTask": {
      "type": "object",
      "properties": {
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "answer_tokens": { "const": "decision-w" },
        "model": { "$ref": "#/$defs/model" },
        "fallback": { "$ref": "#/$defs/fallback" }
      },
      "required": ["reasoning", "answer_tokens", "model", "fallback"],
      "additionalProperties": false
    },
    "textTask": {
      "type": "object",
      "properties": {
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "answer_tokens": { "type": "integer", "minimum": 1 },
        "model": { "$ref": "#/$defs/model" },
        "fallback": { "$ref": "#/$defs/fallback" }
      },
      "required": ["reasoning", "answer_tokens", "model", "fallback"],
      "additionalProperties": false
    },
    "embeddingTask": {
      "type": "object",
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "fallback": { "$ref": "#/$defs/fallback" }
      },
      "required": ["model", "fallback"],
      "additionalProperties": false
    }
  }
}

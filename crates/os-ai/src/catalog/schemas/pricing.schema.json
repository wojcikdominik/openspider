{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Preistabelle resources/ai/pricing.json (AI-010, Nachtrag Q00). Preise in USD je 1 Mio. Tokens, Gebühren in USD, Anteile als Bruch. Eindeutigkeit der Tripel (provider, model, endpoint) und Datumsformat prüft os_ai::catalog::pricing::validate_pricing zusätzlich.",
  "type": "object",
  "properties": {
    "test_only": { "type": "boolean" },
    "source_url": { "type": "string", "minLength": 1 },
    "verified_at": { "$ref": "#/$defs/date" },
    "currency": { "const": "USD" },
    "note": { "type": "string" },
    "prices": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "required": ["prices"],
  "additionalProperties": false,
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "price": { "type": "number", "minimum": 0 },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "factor": { "type": "number", "minimum": 0 },
    "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "entry": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint": { "enum": ["messages", "responses", "decisions", "chat-completions", "embeddings"] },
        "input_per_million": { "$ref": "#/$defs/price" },
        "output_per_million": { "$ref": "#/$defs/price" },
        "cache_read_per_million": { "$ref": "#/$defs/price" },
        "cache_write_per_million": { "$ref": "#/$defs/price" },
        "batch_discount": { "$ref": "#/$defs/fraction" },
        "long_context": {
          "type": "object",
          "properties": {
            "threshold_input_tokens": { "type": "integer", "minimum": 1 },
            "input_factor": { "$ref": "#/$defs/factor" },
            "output_factor": { "$ref": "#/$defs/factor" },
            "cache_read_factor": { "$ref": "#/$defs/factor" }
          },
          "required": ["threshold_input_tokens", "input_factor", "output_factor"],
          "additionalProperties": false
        },
        "regional_surcharge": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z]{2,}$" },
          "additionalProperties": { "$ref": "#/$defs/factor" }
        },
        "per_request": { "$ref": "#/$defs/price" },
        "per_image": { "$ref": "#/$defs/price" },
        "image_tokens": { "type": "integer", "minimum": 0 },
        "valid_from": { "$ref": "#/$defs/date" },
        "source_url": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/date" },
        "reasoning_efforts": {
          "type": "array",
          "items": { "$ref": "#/$defs/effort" },
          "uniqueItems": true
        },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "object",
          "properties": {
            "text": { "type": "boolean" },
            "structured_output": { "type": "boolean" },
            "vision": { "type": "boolean" },
            "embeddings": { "type": "boolean" },
            "decisions": { "type": "boolean" },
            "batch": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "note": { "type": "string" }
      },
      "required": [
        "provider",
        "model",
        "endpoint",
        "input_per_million",
        "output_per_million",
        "source_url",
        "verified_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Anthropic: Fähigkeiten und Stufen kommen live aus capabilities (AI-002, AI-010).",
          "if": { "properties": { "provider": { "const": "anthropic" } }, "required": ["provider"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["capabilities"] },
                { "required": ["reasoning_efforts"] },
                { "required": ["max_output_tokens"] }
              ]
            }
          }
        },
        {
          "$comment": "reasoning_efforts und max_output_tokens nur bei OpenAI (AI-010, Nachtrag).",
          "if": {
            "not": { "properties": { "provider": { "const": "openai" } }, "required": ["provider"] }
          },
          "then": {
            "not": { "anyOf": [{ "required": ["reasoning_efforts"] }, { "required": ["max_output_tokens"] }] }
          }
        },
        {
          "$comment": "Fähigkeitsangaben führt der Katalog nur für OpenAI und Ollama (AI-010).",
          "if": {
            "not": {
              "properties": { "provider": { "enum": ["openai", "ollama"] } },
              "required": ["provider"]
            }
          },
          "then": { "not": { "required": ["capabilities"] } }
        }
      ]
    }
  }
}
